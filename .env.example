# Copy to .env.local for local work, or add in Vercel > Settings > Environment Variables.
# All values are optional. Leave a value empty to show "waiting for setup" in the website.
# These are public values (they are embedded in the browser build). Never put secrets here.

# Production domain, no trailing slash. Used for canonical URLs, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=

# Owner-confirmed LINE Official Account URL, e.g. https://line.me/R/ti/p/@yourid or https://lin.ee/xxxxxxx
# Leave blank until verified. Copying the order message remains available without this value.
NEXT_PUBLIC_LINE_URL=
